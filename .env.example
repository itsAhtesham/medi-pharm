# Docker Compose development database. Production uses a pooled Neon URL.
DATABASE_URL=postgresql://medi_pharm:local_dev_only@127.0.0.1:54329/medi_pharm
# Production uses the direct/unpooled Neon URL for migrations and operations.
DATABASE_DIRECT_URL=postgresql://medi_pharm:local_dev_only@127.0.0.1:54329/medi_pharm
# Generate two separate random values: openssl rand -hex 32
JWT_SECRET=
RATE_LIMIT_SECRET=
APP_URL=http://localhost:3000
# Only set to vercel when deployed behind Vercel's trusted proxy.
TRUSTED_PROXY=none
